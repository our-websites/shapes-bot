# --- Required ---
YAPPER_BOT_TOKEN=YOUR_YAPPER_BOT_TOKEN          # starts with yb_  (Yapper: Settings -> Developer)

# --- Cloudflare D1 (replaces pickledb, free plan is plenty). Leave these out to use local .json files instead. ---
CLOUDFLARE_API_TOKEN=                           # API token with "D1: Edit" permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=                      # Workers & Pages -> D1 -> Create database

# --- Bot owners (comma separated Yapper user ids) for /stop /restart /getdata ---
OWNER_IDS=                                      # full control: every command, DM everyone, the global command log
ADMIN_USER_IDS=                                 # bot admins: dashboard admin tools (separate from owners; an id on both counts once)

# --- Web server ---
PORT=5004
ADMIN_KEY=                                      # password for the web dashboard login
FLASK_SECRET_KEY=                               # any long random string

# --- Optional ---
OPENAI_KEY=                                     # /ai
BRAVE_API_KEY=                                  # /google (Brave Search API: https://api-dashboard.search.brave.com)
GOOGLE_API_KEY=                                 # /google fallback until Google's API shuts down Jan 1, 2027
SHAPES_API_URL=http://127.0.0.1:1337             # the Shapes API (api.shapes.lol repo) running on this machine
# Dashboard login fallback: used when the Shapes API is down. Register https://<your PUBLIC_URL>/dashboard/oauth/callback as the redirect URI.
YAPIN_CLIENT_ID=
YAPIN_CLIENT_SECRET=
# YAPIN_AUTHORIZE_URL=https://www.yapin.gg/oauth/authorize
# YAPIN_TOKEN_URL=https://www.yapin.gg/api/oauth/token
# YAPIN_USERINFO_URL=https://www.yapin.gg/api/oauth/me
# YAPIN_SCOPE=identify
# PlayVortex: optional shared login for /vortexinfo, and the cookie's name when someone pastes only its value
# PLAYVORTEX_COOKIE=
# PLAYVORTEX_COOKIE_NAME=session
SHAPES_API_TOKEN=                               # same value as the API's INTERNAL_TOKEN; Roblox + Last.fm linking go through it
YAPPER_INVITE_URL=                              # what /invite links to
YAPPER_EMBED_MODE=auto                          # auto | embed | text

# Last.fm linking (optional): create an API account at https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=
PUBLIC_URL=                                     # where this web server is reachable, e.g. https://bot.example.com (no trailing slash)

# --- Website + user dashboard ---
PUBLIC_URL=https://shapes.lol                   # where this bot's web server is reachable (login returns here)
API_PUBLIC_URL=https://api.shapes.lol           # the Shapes API's public address (Login with Yapin' starts there)
ADMIN_USER_IDS=                                 # Yapin user ids that see the Admin tab (defaults to OWNER_IDS)
# Login with Yapin': set YAPIN_CLIENT_ID / YAPIN_CLIENT_SECRET (and YAPIN_RETURN_HOSTS=<this site's host>) in the API's .env
