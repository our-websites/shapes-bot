# Copy this file to .env and fill it in. .env is ignored by git; never commit it.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=
# Bot owners besides the built-in ones (comma separated Discord user IDs)
OWNER_IDS=

# --- Shapes API (shared with the Yapin' bot; this bot has its own database) ---
SHAPES_API_URL=http://localhost:1337
# The API's INTERNAL_TOKEN / SHAPES_API_TOKEN. The old name Shapes_API_Key still works.
SHAPES_API_TOKEN=
# Where members find their Roblox accounts on Yapin' (optional)
YAPIN_DASH_URL=https://shapes-yapper.oriaxen.com/dashboard/roblox

# --- Database: Cloudflare D1 (a separate database from the Yapin' bot's) ---
# Leave these empty to keep using local files while developing.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# --- Other services ---
OPENAI_KEY=
GOOGLE_API_KEY=
ROBLOSECURITY=
# Password for the /login admin page (empty = nobody can sign in)
ADMIN_KEY=
FLASK_SECRET_KEY=
PORT=13455

# --- top.gg (optional) ---
Commands-TK=
TOPGG_TOKEN=

# --- PlayVortex (optional) ---
PLAYVORTEX_URL=https://playvortex.io
PLAYVORTEX_COOKIE_NAME=session
# One login used for everyone's lookups (optional; people can save their own with /vortex cookie)
PLAYVORTEX_COOKIE=

# --- Command log webhook (optional) ---
webhook_url=
