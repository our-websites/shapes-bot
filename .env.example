# Copy this file to .env and fill it in. .env is ignored by git; never commit it.

# --- Discord ---
DISCORD_TOKEN=
# From discord.com/developers > your app > General Information. Verifies Discord's signed event webhooks.
# Set the app's "Webhook Events URL" to https://YOUR-HOST/discord/webhook (events are posted to webhook_url below).
DISCORD_PUBLIC_KEY=
# Optional: lets bot owners sign in to the dashboard with Discord (OAuth2 > Client ID / Client Secret).
# Add https://YOUR-HOST/login/discord/callback under OAuth2 > Redirects. REDIRECT_URI is only needed if it can't be worked out from the request.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Bot owners besides the built-in ones (comma separated Discord user IDs)
OWNER_IDS=

# --- Shapes API (shared with the Yapin' bot; this bot has its own database) ---
SHAPES_API_URL=http://localhost:1337
# The API's INTERNAL_TOKEN / SHAPES_API_TOKEN. The old name Shapes_API_Key still works.
SHAPES_API_TOKEN=
# Where members find their Roblox accounts on Yapin' (optional)
YAPIN_DASH_URL=https://shapes-yapper.oriaxen.com/dashboard/roblox

# --- Database: Cloudflare D1 (a separate database from the Yapin' bot's) ---
# Leave these empty to keep using local files while developing.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# --- Other services ---
OPENAI_KEY=
GOOGLE_API_KEY=
ROBLOSECURITY=
# Password for the /login admin page (empty = nobody can sign in)
# Password for the web dashboard at / (sign in at /login). Empty = nobody can sign in.
ADMIN_KEY=
# Signs the dashboard login cookie. Leave empty and a new one is made on every start (you get signed out when the bot restarts).
FLASK_SECRET_KEY=
PORT=13455

# --- top.gg (optional) ---
Commands-TK=
TOPGG_TOKEN=

# --- PlayVortex (optional) ---
PLAYVORTEX_URL=https://playvortex.io
PLAYVORTEX_COOKIE_NAME=session
# One login used for everyone's lookups (optional; people can save their own with /vortex cookie)
PLAYVORTEX_COOKIE=

# --- Command log webhook (optional) ---
webhook_url=
