# --- Required ---
YAPPER_BOT_TOKEN=YOUR_YAPPER_BOT_TOKEN          # starts with yb_  (Yapper: Settings -> Developer)

# --- Cloudflare D1 (replaces pickledb, free plan is plenty). Leave these out to use local .json files instead. ---
CLOUDFLARE_API_TOKEN=                           # API token with "D1: Edit" permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=                      # Workers & Pages -> D1 -> Create database

# --- Bot owners (comma separated Yapper user ids) for /stop /restart /getdata ---
OWNER_IDS=

# --- Web server ---
PORT=5004
ADMIN_KEY=                                      # password for the web dashboard login
FLASK_SECRET_KEY=                               # any long random string

# --- Optional ---
OPENAI_KEY=                                     # /ai
BRAVE_API_KEY=                                  # /google (Brave Search API: https://api-dashboard.search.brave.com)
GOOGLE_API_KEY=                                 # /google fallback until Google's API shuts down Jan 1, 2027
Shapes_API_Key=                                 # your shapes.lol API (roblox2discord / discord2roblox)
SPOOK_API_KEY=                                  # /discord2spook
YAPPER_INVITE_URL=                              # what /invite links to
YAPPER_EMBED_MODE=auto                          # auto | embed | text
